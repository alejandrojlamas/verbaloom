# Safe, credential-free defaults for the local Docker deployment.
# Copy this file to deployment/.env and add provider keys only on your machine.

PORT=5000
LLM_PROVIDER=ollama
API_ENDPOINT=http://host.docker.internal:11434/api/generate
DEFAULT_MODEL=qwen3:14b
OLLAMA_NUM_CTX=8192
REQUEST_TIMEOUT=900

# Optional cloud-provider credentials. Never commit real values.
GEMINI_API_KEY=
OPENAI_API_KEY=
